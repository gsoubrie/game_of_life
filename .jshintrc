{
  "node": true,
  "camelcase": false,
  "browser": true,
  "esversion": 6,
  "bitwise": true,
  "curly": true,
  "eqeqeq": true,
  "immed": true,
  "indent": 4,
  "latedef": false,
  "newcap": true,
  "noarg": true,
  "quotmark": false,
  "undef": true,
  "unused": false,
  "strict": true,
  "sub": true,
  "trailing": true,
  "smarttabs": true,
  "expr": true,
  "varstmt": false,
  "funcscope": true,
  "laxbreak": true,
  "globals": {
    "Grid": false,
    "Game": false,
    "Viewport": false
  }
}

